pipeline {
    agent any

    parameters {
        string(name: 'SCENARIO_JSON', description: 'JSON scenario from backend')
        string(name: 'TEST_RESULT_ID', description: 'Test result ID for callback')
    }

    environment {
        // Configuration Git
        GIT_REPO = 'https://github.com/malek-soukeh/testmanagement.git'
        GIT_BRANCH = 'master'
        
        // Configuration Backend
        BACKEND_URL = 'http://192.168.56.1:8081'
        CALLBACK_TOKEN = credentials('perf-callback-token')
        
        // Chemins
        RESULTS_DIR = "${WORKSPACE}/results"
        REPORTS_DIR = "${WORKSPACE}/reports"
    }

    stages {
        stage('Checkout Git Repository') {
            steps {
                echo '📥 Clonage ou mise à jour du dépôt Git pour récupérer template.xml...'
                git branch: 'master', url: 'https://github.com/malek-soukeh/testmanagement.git', changelog: false, poll: false
                sh '''
                echo "Vérification de template.xml..."
                if [ ! -f template.xml ]; then
                    echo "❌ template.xml introuvable !"
                    exit 1
                fi
                ls -lh template.xml
                '''
            }
        }

        stage('Parse JSON and Extract Parameters') {
            steps {
                script {
                    echo '📋 Parsing du scénario JSON...'
                    
                    if (!params.SCENARIO_JSON || params.SCENARIO_JSON.trim().isEmpty()) {
                        error("❌ SCENARIO_JSON parameter is required")
                    }
                    
                    if (!params.TEST_RESULT_ID || params.TEST_RESULT_ID.trim().isEmpty()) {
                        error("❌ TEST_RESULT_ID parameter is required")
                    }
                    
                    // Script Python pour parser le JSON
                    def parseScript = """
import json
import sys
import os
try:
    from urllib.parse import urlparse
except ImportError:
    from urlparse import urlparse

try:
    scenario_json = os.environ.get('SCENARIO_JSON', '{}')
    data = json.loads(scenario_json)
    
    # Parser l'URL
    url = data.get('url', '')
    if url:
        parsed = urlparse(url)
        protocol = parsed.scheme
        domain = parsed.netloc.split(':')[0] if ':' in parsed.netloc else parsed.netloc
        port = parsed.port if parsed.port else ''
        path = parsed.path if parsed.path else '/'
    else:
        protocol = 'http'
        domain = 'localhost'
        port = ''
        path = '/'
    
    # Extraire les paramètres de performance
    perf = data.get('performance', {})
    users = str(perf.get('numberOfUsers', 10))
    ramp_up = str(perf.get('rampUpSeconds', 10))
    duration = str(perf.get('durationSeconds', 60))
    timeout = str(perf.get('timeoutMs', 5000))
    requests_per_second = str(perf.get('requestsPerSecond', '')) if perf.get('requestsPerSecond') else ''
    
    # Paramètres supplémentaires
    add_params = perf.get('additionalParams') or {}
    method = perf.get('method') or add_params.get('method', 'GET')
    authorization = perf.get('authorization') or add_params.get('authorization', '')
    content_type = perf.get('contentType') or add_params.get('contentType', 'application/json')
    
    # Écrire les variables d'environnement dans un fichier
    with open('jenkins_env.sh', 'w') as f:
        f.write(f'export PROTOCOL={protocol}\\n')
        f.write(f'export DOMAIN={domain}\\n')
        f.write(f'export PORT={port}\\n')
        f.write(f'export REQUEST_PATH={path}\\n')
        f.write(f'export USERS={users}\\n')
        f.write(f'export RAMP_UP={ramp_up}\\n')
        f.write(f'export DURATION={duration}\\n')
        f.write(f'export TIMEOUT={timeout}\\n')
        f.write(f'export REQUESTS_PER_SECOND={requests_per_second}\\n')
        f.write(f'export METHOD={method}\\n')
        f.write(f'export AUTHORIZATION={authorization}\\n')
        f.write(f'export CONTENT_TYPE={content_type}\\n')
    
    print("✅ Paramètres extraits avec succès")
except Exception as e:
    print(f"❌ Erreur lors du parsing JSON: {e}", file=sys.stderr)
    sys.exit(1)
"""
                    writeFile file: 'parse_params.py', text: parseScript
                    
                    // Exécuter le script
                    sh """
                        export SCENARIO_JSON='${params.SCENARIO_JSON}'
                        python3 parse_params.py
                    """
                    
                    // Charger les variables d'environnement
                    sh '''
                        . ./jenkins_env.sh
                        echo "Paramètres extraits:"
                        echo "  URL: $PROTOCOL://$DOMAIN${PORT:+:$PORT}$REQUEST_PATH"
                        echo "  Users: $USERS"
                        echo "  Ramp-up: ${RAMP_UP}s"
                        echo "  Duration: ${DURATION}s"
                    '''
                    
                    // Créer les répertoires
                    sh '''
                        mkdir -p ${RESULTS_DIR}
                        mkdir -p ${REPORTS_DIR}
                    '''
                }
            }
        }

        stage('Run JMeter Test') {
            steps {
                script {
                    sh """
                        . ./jenkins_env.sh
                        export RESULT_FILE="${RESULTS_DIR}/result_${BUILD_NUMBER}.jtl"
                        
                        # Fallback pour requests per second
                        if [ -z "\$REQUESTS_PER_SECOND" ]; then
                            REQUESTS_PER_SECOND="1"
                        fi

                        /opt/jmeter/bin/jmeter -n -t template.xml \\
                            -JUSERS=\$USERS \\
                            -JRAMP_UP=\$RAMP_UP \\
                            -JDURATION=\$DURATION \\
                            -JUSE_DURATION=true \\
                            -JPROTOCOL=\$PROTOCOL \
                            -JDOMAIN=\$DOMAIN \\
                            -JPORT=\$PORT \\
                            -JPATH=\$REQUEST_PATH \\
                            -JMETHOD=\$METHOD \\
                            -JAUTHORIZATION="\$AUTHORIZATION" \\
                            -JCONTENT_TYPE="\$CONTENT_TYPE" \\
                            -JTIMEOUT=\$TIMEOUT \\
                            -JREQUESTS_PER_SECOND=\$REQUESTS_PER_SECOND \\
                            -JRESULT_FILE=\$RESULT_FILE \\
                            -l \$RESULT_FILE
                    """
                }
            }
        }

        stage('Generate HTML Report') {
            steps {
                script {
                    echo '📊 Génération du rapport HTML...'
                    
                    sh """
                        RESULT_FILE="${RESULTS_DIR}/result_${BUILD_NUMBER}.jtl"
                        REPORT_DIR="${REPORTS_DIR}/report_${BUILD_NUMBER}"
                        
                        if [ -f "\$RESULT_FILE" ]; then
                            mkdir -p "\$REPORT_DIR"
                            /opt/jmeter/bin/jmeter -g "\$RESULT_FILE" -o "\$REPORT_DIR" || echo "⚠️ Génération rapport HTML échouée"
                        fi
                    """
                }
            }
        }

        stage('Parse Results and Send Callback') {
            steps {
                script {
                    echo '📤 Parsing des résultats et envoi du callback...'
                    
                    def processScript = """
import csv
import sys
import os
import json
import subprocess

result_file = os.environ.get('RESULT_FILE', '')
test_result_id = os.environ.get('TEST_RESULT_ID', '')
backend_url = os.environ.get('BACKEND_URL', 'http://192.168.56.1:8081')
callback_token = os.environ.get('CALLBACK_TOKEN', '')
build_url = os.environ.get('BUILD_URL', '')
build_number = os.environ.get('BUILD_NUMBER', '')

# Structure pour stocker les résultats par label (sampler)
results_by_label = {}
all_response_times = []
total_errors = 0
total_requests = 0

try:
    if not os.path.exists(result_file):
        print(f"Result file not found: {result_file}")
        sys.exit(0)

    with open(result_file, 'r') as f:
        reader = csv.reader(f)
        for row in reader:
            if len(row) < 2 or row[0] == 'timeStamp':
                continue
            
            total_requests += 1
            try:
                elapsed = int(row[1])
                label = row[2] if len(row) > 2 else "Unknown"
                success = row[7] == 'true' if len(row) > 7 else False
                
                all_response_times.append(elapsed)
                
                if not success:
                    total_errors += 1
                
                if label not in results_by_label:
                    results_by_label[label] = {
                        "response_times": [],
                        "errors": 0,
                        "total": 0
                    }
                
                results_by_label[label]["response_times"].append(elapsed)
                results_by_label[label]["total"] += 1
                if not success:
                    results_by_label[label]["errors"] += 1
                    
            except Exception as e:
                pass
    
    # Calculer les métriques globales
    avg = 0
    max_time = 0
    p95 = 0
    error_rate = 100.0
    status = "FAILED"
    
    if all_response_times:
        all_response_times.sort()
        avg = round(sum(all_response_times) / len(all_response_times))
        max_time = max(all_response_times)
        p95 = all_response_times[int(len(all_response_times) * 0.95)]
        error_rate = round((total_errors / total_requests) * 100 * 100) / 100
        status = "PASSED" if error_rate < 5 else "FAILED"

    # Construire le rapport détaillé (steps)
    steps_details = []
    for label, data in results_by_label.items():
        times = data["response_times"]
        times.sort()
        step_avg = round(sum(times) / len(times)) if times else 0
        step_max = max(times) if times else 0
        step_p95 = times[int(len(times) * 0.95)] if times else 0
        step_error_rate = round((data["errors"] / data["total"]) * 100 * 100) / 100 if data["total"] > 0 else 0
        
        steps_details.append({
            "stepName": label,
            "totalRequests": data["total"],
            "avgResponseTime": step_avg,
            "maxResponseTime": step_max,
            "p95ResponseTime": step_p95,
            "errorRate": step_error_rate,
            "status": "PASSED" if step_error_rate < 5 else "FAILED"
        })

    # Construire le JSON complet (summaryJson)
    summary_json = {
        "title": "Performance Test Results",
        "overallPassed": status == "PASSED",
        "totalRequests": total_requests,
        "avgResponseTime": avg,
        "maxResponseTime": max_time,
        "p95ResponseTime": p95,
        "errorRate": error_rate,
        "steps": steps_details
    }

    # Construire le payload du callback
    payload = {
        "status": status,
        "avgResponseTimeMs": avg,
        "maxResponseTimeMs": max_time,
        "p95ResponseTimeMs": p95,
        "errorRatePercent": error_rate,
        "jmeterReportUrl": f"{build_url}artifact/reports/report_{build_number}/index.html",
        "summaryJson": json.dumps(summary_json)
    }
    
    # Envoyer le callback avec curl
    callback_url = f"{backend_url}/api/performance/results/{test_result_id}/callback"
    json_payload = json.dumps(payload)
    
    curl_cmd = [
        'curl', '-X', 'POST',
        callback_url,
        '-H', 'Content-Type: application/json',
        '-H', f'X-JENKINS-TOKEN: {callback_token}',
        '-d', json_payload,
        '-w', '\\nHTTP Status: %{http_code}'
    ]
    
    result = subprocess.run(curl_cmd, capture_output=True, text=True)
    
    if result.returncode == 0 and ('200' in result.stdout or '201' in result.stdout):
        print("✅ Callback envoyé avec succès")
    else:
        print(f"⚠️  Erreur lors de l'envoi du callback: {result.stderr}", file=sys.stderr)
        print(f"Response: {result.stdout}", file=sys.stderr)

except Exception as e:
    print(f"❌ Erreur lors du parsing JTL: {e}", file=sys.stderr)
    sys.exit(1)
"""
                    writeFile file: 'process_results.py', text: processScript
                    
                    sh """
                        export RESULT_FILE="${RESULTS_DIR}/result_${BUILD_NUMBER}.jtl"
                        export TEST_RESULT_ID="${params.TEST_RESULT_ID}"
                        export BACKEND_URL="${BACKEND_URL}"
                        export CALLBACK_TOKEN="${CALLBACK_TOKEN}"
                        export BUILD_URL="${env.BUILD_URL}"
                        export BUILD_NUMBER="${env.BUILD_NUMBER}"
                        
                        python3 process_results.py
                    """
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                echo '📦 Archivage des artefacts...'
                archiveArtifacts artifacts: "results/*.jtl, reports/**/*", allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            echo '🧹 Nettoyage...'
        }
        success {
            echo '✅ Pipeline terminé avec succès'
        }
        failure {
            echo '❌ Pipeline échoué'
            script {
                // Envoyer un callback d'erreur via curl
                try {
                    sh """
                        curl -X POST "${BACKEND_URL}/api/performance/results/${params.TEST_RESULT_ID}/callback" \\
                        -H "Content-Type: application/json" \\
                        -H "X-JENKINS-TOKEN: ${CALLBACK_TOKEN}" \\
                        -d '{"status": "FAILED", "errorRatePercent": 100.0}'
                    """
                } catch (Exception e) {
                    echo "⚠️  Impossible d'envoyer le callback d'erreur: ${e.message}"
                }
            }
        }
    }
}
